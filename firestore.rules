rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role check
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || request.auth.token.email == 'mwanjeg039@gmail.com');
    }

    // Entity Validations
    function isValidSchoolSettings(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.level in ['Primary', 'Secondary']
        && (data.classes is list && data.classes.size() <= 100);
    }

    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.reg is string && data.reg.size() > 0 && data.reg.size() <= 50
        && data.class is string && data.class.size() > 0 && data.class.size() <= 50
        && (!('feesBalance' in data) || data.feesBalance is number);
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && data.role in ['admin', 'teacher', 'student', 'parent', 'accountant', 'staff', 'driver', 'librarian', 'nurse'];
    }

    function isValidBorrowing(data) {
      return data.studentId is string && isValidId(data.studentId)
        && data.bookTitle is string && data.bookTitle.size() > 0 && data.bookTitle.size() <= 200
        && data.borrowDate is string && data.dueDate is string
        && data.status in ['active', 'returned', 'overdue'];
    }

    function isValidHealthRecord(data) {
      return data.studentId is string && isValidId(data.studentId)
        && data.sickness is string && data.sickness.size() > 0 && data.sickness.size() <= 500
        && data.status in ['sick', 'sent-home', 'back-in-class', 'monitored']
        && data.date is string;
    }

    function isValidTransaction(data) {
      return data.type in ['income', 'expense']
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.amount is number
        && data.date is string
        && data.status is string;
    }

    function isValidBook(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.author is string && data.author.size() > 0 && data.author.size() <= 200
        && data.available is number && data.total is number;
    }

    function isValidMark(data) {
      return data.studentId is string && data.subject is string && data.score is number;
    }

    function isValidProduct(data) {
      return data.name is string && data.price is number && data.quantity is number;
    }

    function isValidExpense(data) {
      return data.description is string && data.amount is number;
    }

    function isValidStaff(data) {
      return data.name is string && data.employeeId is string && data.role is string
        && data.salary is number && data.status in ['active', 'on-leave', 'terminated'];
    }

    function isValidLeaveRequest(data) {
      return data.staffId is string && data.startDate is string && data.endDate is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.type in ['sick', 'vacation', 'emergency', 'other'];
    }

    function isValidFeeStructure(data) {
      return data.className is string && data.term is string && data.totalAmount is number;
    }

    function isValidAttendance(data) {
      return data.studentId is string && data.date is string 
        && data.status in ['present', 'absent', 'late']
        && data.role in ['Student', 'Staff']
        && (!('biometricVerified' in data) || data.biometricVerified is bool);
    }

    function isValidVehicle(data) {
      return data.plateNumber is string && data.model is string && data.driverId is string
        && data.capacity is number && data.status in ['active', 'maintenance', 'inactive'];
    }

    function isValidRoute(data) {
      return data.name is string && data.stops is list;
    }

    function isValidTimetable(data) {
      return data.day is string && data.startTime is string && data.endTime is string
        && data.subject is string && data.teacherId is string
        && (data.class is string || data.className is string)
        && data.room is string;
    }

    function isValidNotification(data) {
      return data.userId is string && data.title is string && data.message is string
        && data.type in ['info', 'warning', 'error', 'success'] && data.read is bool;
    }

    function isValidDormitory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.capacity is number
        && data.gender in ['Male', 'Female', 'Mixed']
        && data.rooms is list;
    }

    function isValidDormRoom(data) {
      return data.dormId is string
        && data.roomNumber is string && data.roomNumber.size() > 0 && data.roomNumber.size() <= 50
        && data.capacity is number
        && data.occupants is list;
    }

    function isValidDormAllocation(data) {
      return data.studentId is string
        && data.studentName is string
        && data.dormId is string
        && data.roomId is string
        && data.allocationDate is string
        && data.status in ['active', 'checked-out'];
    }

    // Collection Rules
    match /settings/school {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSchoolSettings(incoming());
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(incoming());
      allow update: if isSignedIn() && isValidStudent(incoming());
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && isValidUser(incoming()));
      allow delete: if isAdmin();
    }

    match /borrowings/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidBorrowing(incoming());
      allow update: if isSignedIn() && isValidBorrowing(incoming());
      allow delete: if isAdmin();
    }

    match /healthRecords/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidHealthRecord(incoming());
      allow update: if isSignedIn() && isValidHealthRecord(incoming());
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isAdmin() && isValidTransaction(incoming());
      allow delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidBook(incoming());
      allow update: if isSignedIn() && isValidBook(incoming());
      allow delete: if isAdmin();
    }

    match /marks/{markId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMark(incoming());
      allow update: if isSignedIn() && isValidMark(incoming());
      allow delete: if isAdmin();
    }

    match /inventory/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidExpense(incoming());
      allow update: if isSignedIn() && isValidExpense(incoming());
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidStaff(incoming());
      allow update: if isAdmin() && isValidStaff(incoming());
      allow delete: if isAdmin();
    }

    match /leaveRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLeaveRequest(incoming());
      allow update: if isSignedIn() && isValidLeaveRequest(incoming());
      allow delete: if isAdmin();
    }

    match /feeStructures/{structureId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidFeeStructure(incoming());
      allow update: if isAdmin() && isValidFeeStructure(incoming());
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAttendance(incoming());
      allow update: if isSignedIn() && isValidAttendance(incoming());
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidVehicle(incoming());
      allow update: if isAdmin() && isValidVehicle(incoming());
      allow delete: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidRoute(incoming());
      allow update: if isAdmin() && isValidRoute(incoming());
      allow delete: if isAdmin();
    }

    match /timetable/{entryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidTimetable(incoming());
      allow update: if isAdmin() && isValidTimetable(incoming());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid)) && isValidNotification(incoming());
      allow delete: if isAdmin();
    }

    match /dormitories/{dormitoryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDormitory(incoming());
      allow update: if isAdmin() && isValidDormitory(incoming());
      allow delete: if isAdmin();
    }

    match /dormRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDormRoom(incoming());
      allow update: if isAdmin() && isValidDormRoom(incoming());
      allow delete: if isAdmin();
    }

    match /dormAllocations/{allocationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidDormAllocation(incoming());
      allow update: if isAdmin() && isValidDormAllocation(incoming());
      allow delete: if isAdmin();
    }
  }
}
